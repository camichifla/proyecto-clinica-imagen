RewriteEngine On

# BASE = URL prefix of this directory ("/" at the web root, "/proyecto/" in a subfolder).
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

RewriteRule ^logout\.php$ api/logout.php [L]

RewriteRule ^(index|login|register|reset-request|reset-confirm|verify|agenda|solicitudes-cita|agendar-cita|agendar-cita-medico|resultados|ver-resultados|cargar-resultados|manejar-usuarios|modificar-usuario|panel|turnos|gestion-estudios|gestion-sucursales|gestion-profesionales|gestion-pacientes|contacto|servicios|mensajes-contacto)\.php$ %{ENV:BASE}$1.html [R=301,L,QSA]

RewriteRule ^$ views/index.html [L]
RewriteRule ^index\.html$ views/index.html [L]
RewriteRule ^login\.html$ views/login.html [L]
RewriteRule ^register\.html$ views/register.html [L]
RewriteRule ^reset-request\.html$ views/reset-request.html [L]
RewriteRule ^reset-confirm\.html$ views/reset-confirm.html [L]
RewriteRule ^verify\.html$ views/verify.html [L]
RewriteRule ^contacto\.html$ views/contacto.html [L]
RewriteRule ^servicios\.html$ views/servicios.html [L]

RewriteRule ^agenda\.html$ views/agenda.html [L]
RewriteRule ^solicitudes-cita\.html$ views/solicitudes-cita.html [L]
RewriteRule ^agendar-cita\.html$ views/agendar-cita.html [L]
RewriteRule ^agendar-cita-medico\.html$ views/agendar-cita-medico.html [L]

RewriteRule ^resultados\.html$ views/resultados.html [L]
RewriteRule ^ver-resultados\.html$ views/ver-resultados.html [L]
RewriteRule ^cargar-resultados\.html$ views/cargar-resultados.html [L]
RewriteRule ^manejar-usuarios\.html$ views/manejar-usuarios.html [L]
RewriteRule ^modificar-usuario\.html$ views/modificar-usuario.html [L]
RewriteRule ^panel\.html$ views/panel.html [L]
RewriteRule ^turnos\.html$ views/turnos.html [L]
RewriteRule ^gestion-estudios\.html$ views/gestion-estudios.html [L]
RewriteRule ^gestion-sucursales\.html$ views/gestion-sucursales.html [L]
RewriteRule ^gestion-profesionales\.html$ views/gestion-profesionales.html [L]
RewriteRule ^gestion-pacientes\.html$ views/gestion-pacientes.html [L]
RewriteRule ^mensajes-contacto\.html$ views/mensajes-contacto.html [L]

RewriteRule ^ver-agenda\.html$ %{ENV:BASE}agenda.html [R=301,L,QSA]
RewriteRule ^(buscar-resultados|historial-pacientes)\.html$ %{ENV:BASE}resultados.html [R=301,L,QSA]
RewriteRule ^enviar-resultados\.html$ %{ENV:BASE}cargar-resultados.html [R=301,L,QSA]

RewriteRule ^ver-resultado-imagen\.php$ api/ver-resultado-imagen.php [L]
