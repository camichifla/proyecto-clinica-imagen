RewriteEngine On

# BASE = URL prefix of this directory ("/" at the web root, "/proyecto/" in a subfolder).
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

RewriteRule ^logout\.php$ api/logout.php [L]

RewriteRule ^(index|login|register|reset-request|reset-confirm|verify|agenda|ver-agenda|solicitudes-cita|agendar-cita|agendar-cita-medico|buscar-resultados|historial-pacientes|resultados|ver-resultados|cargar-resultados|enviar-resultados|manejar-usuarios|modificar-usuario)\.php$ %{ENV:BASE}$1.html [R=301,L,QSA]

RewriteRule ^$ views/index.html [L]
RewriteRule ^index\.html$ views/index.html [L]
RewriteRule ^login\.html$ views/login.html [L]
RewriteRule ^register\.html$ views/register.html [L]
RewriteRule ^reset-request\.html$ views/reset-request.html [L]
RewriteRule ^reset-confirm\.html$ views/reset-confirm.html [L]
RewriteRule ^verify\.html$ views/verify.html [L]

RewriteRule ^agenda\.html$ views/agenda.html [L]
RewriteRule ^ver-agenda\.html$ views/ver-agenda.html [L]
RewriteRule ^solicitudes-cita\.html$ views/solicitudes-cita.html [L]
RewriteRule ^agendar-cita\.html$ views/agendar-cita.html [L]
RewriteRule ^agendar-cita-medico\.html$ views/agendar-cita-medico.html [L]

RewriteRule ^buscar-resultados\.html$ views/buscar-resultados.html [L]
RewriteRule ^resultados\.html$ views/resultados.html [L]
RewriteRule ^historial-pacientes\.html$ views/historial-pacientes.html [L]
RewriteRule ^ver-resultados\.html$ views/ver-resultados.html [L]
RewriteRule ^cargar-resultados\.html$ views/cargar-resultados.html [L]
RewriteRule ^enviar-resultados\.html$ views/enviar-resultados.html [L]
RewriteRule ^manejar-usuarios\.html$ views/manejar-usuarios.html [L]
RewriteRule ^modificar-usuario\.html$ views/modificar-usuario.html [L]

RewriteRule ^ver-resultado-imagen\.php$ api/ver-resultado-imagen.php [L]
