# /etc/cron.d/clinica-imagen — scheduled backups for Clinica Imagen.
# Formato: minuto hora día-mes mes día-semana usuario comando

# Shell y PATH explícitos: cron arranca con un entorno mínimo.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Base de datos: volcado comprimido todos los días a las 02:00.
0 2 * * * root /usr/local/sbin/clinica-respaldo db

# Archivos: /etc y la aplicación (incluye storage/resultados) los domingos a las 03:00.
0 3 * * 0 root /usr/local/sbin/clinica-respaldo archivos

# Remoto: sube /var/backups/operador con rclone todos los días a las 04:00 (se omite si no hay remote configurado).
0 4 * * * root /usr/local/sbin/clinica-respaldo remoto

# Limpieza: borra eventos de throttle de más de 90 días (los de auditoría se conservan), todos los días a las 05:00.
0 5 * * * root mariadb clinica_imagen -e "DELETE FROM eventos WHERE tipo IN ('login_fallo','reset_solicitud','contacto','verif_reenvio','registro_intento') AND creado_en < NOW() - INTERVAL 90 DAY"

# Cambios de correo sin confirmar: si venció el token, se descarta el correo solicitado (cada hora; verify y el perfil también lo hacen).
0 * * * * root cd /var/www/clinica-imagen && php -r 'require "includes/mailer.php"; limpiar_emails_pendientes(db());'

# Cuentas de pacientes sin verificar por más de 48 h: se borran (y su ficha si no tiene historia) para liberar la CI (cada hora).
15 * * * * root cd /var/www/clinica-imagen && php -r 'require "includes/pacientes.php"; limpiar_cuentas_sin_verificar(db());'
